# For local Docker MongoDB:
MONGO_ROOT_USERNAME=zeek_root
MONGO_ROOT_PASSWORD=zeek_root_dev
MONGO_DB_NAME=zeek_auth
MONGO_PORT=27017

# Auth backend selection: mongodb (default) or mysql
AUTH_DB_BACKEND=mongodb

# For app authentication with MongoDB (Atlas or local):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/zeek_auth?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=zeek_auth

# For app authentication with MySQL (server/local):
# AUTH_DB_BACKEND=mysql
# AUTH_MYSQL_URI=mysql://<db_user>:<db_password>@<host>:3306/<database>
AUTH_MYSQL_HOST=127.0.0.1
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_USER=zeek_auth_user
AUTH_MYSQL_PASSWORD=change-me
AUTH_MYSQL_DATABASE=zeek_auth

AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=604800
